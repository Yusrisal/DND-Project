# The server-side configuration, which lives at /opt/dnd/.env and is never
# touched by a deploy. It holds the database password, so:
#
#   sudo chown dnd:dnd /opt/dnd/.env && sudo chmod 600 /opt/dnd/.env

# Marks the session cookie Secure, so it is only ever sent over HTTPS. The
# tunnel terminates TLS, so this is correct here — but it means you cannot sign
# in by hitting http://192.168.1.15:8080 directly. Use the real hostname.
APP_ENV=production

HTTP_ADDR=:8080

# Your own MySQL. Either give the whole DSN:
#
#   DB_DSN=dnd:secret@tcp(127.0.0.1:3306)/dnd?parseTime=true&charset=utf8mb4&loc=Local
#
# or the parts, which is easier to read and avoids escaping a password:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dnd
DB_PASSWORD=change-me
DB_NAME=dnd

# Must be the real hostname. This gates both CORS and the websocket Origin
# check, so a stale value here means the page loads but the board never
# connects — which reads as "realtime is broken" rather than "config is wrong".
CORS_ORIGINS=https://dnd.yyuuss.online

# The built frontend. Point it at the symlink, not at a release directory, or
# the app will keep serving whichever release was current when you wrote this.
WEB_DIR=/opt/dnd/current/dist

# Uploaded images. This one must sit *outside* current/, or the next deploy
# and the release pruning take every uploaded map with it.
UPLOAD_DIR=/opt/dnd/uploads
