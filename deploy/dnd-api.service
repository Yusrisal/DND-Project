# /etc/systemd/system/dnd-api.service
#
#   sudo cp deploy/dnd-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now dnd-api
#
# The unit serves the API, the websocket and the built frontend on one port.
# Point the Cloudflare Tunnel ingress at http://localhost:8080.

[Unit]
Description=DnD table API and websocket gateway
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=dnd
Group=dnd
WorkingDirectory=/opt/dnd
EnvironmentFile=/opt/dnd/.env
ExecStart=/opt/dnd/bin/dnd-api
Restart=on-failure
RestartSec=5s

# The service needs nothing outside its own directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/dnd

[Install]
WantedBy=multi-user.target
