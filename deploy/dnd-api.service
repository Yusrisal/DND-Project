# /etc/systemd/system/dnd-api.service
#
# Installed by `./deploy/dnd-deploy setup`. The unit serves the API, the
# websocket and the built frontend on one port, so the Cloudflare Tunnel needs
# one ingress rule pointing at http://localhost:8080.
#
# ExecStart goes through the `current` symlink rather than a release directory,
# which is what lets a rollback be a symlink swap and a restart.

[Unit]
Description=DnD table API and websocket gateway
After=network-online.target mysql.service mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=dnd
Group=dnd
WorkingDirectory=/opt/dnd
EnvironmentFile=/opt/dnd/.env
ExecStart=/opt/dnd/current/bin/dnd-api
Restart=on-failure
RestartSec=5s

# The service needs nothing outside its own directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/dnd

[Install]
WantedBy=multi-user.target
