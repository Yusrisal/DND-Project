# Copy to deploy/deploy.env and fill in.
#
# That file is gitignored, so it does NOT travel with a git pull — create it on
# whichever machine you run the deploy from. It holds no passwords: the database
# credentials live in /opt/dnd/.env on the server and never leave it.

# --- Where are you deploying from? ---
#
# Leave SSH_HOST empty when the repository is already on the server and you run
# the deploy there. Nothing is transferred; the build is installed straight into
# /opt/dnd/releases.
SSH_HOST=
SSH_USER=
SSH_PORT=22

# Set them instead when you push from a workstation:
#   SSH_HOST=192.168.1.15
#   SSH_USER=root

# Where the app lives on the server, and what the unit is called.
REMOTE_DIR=/opt/dnd
SERVICE=dnd-api

# The unprivileged account the service runs as, created by `dnd-deploy setup`.
# It is not the account you deploy as.
SERVICE_USER=dnd

# Empty if you are root. Otherwise leave it as sudo.
SUDO=

# Checked after every restart; a deploy that cannot reach it rolls itself back.
# This MUST match HTTP_ADDR in /opt/dnd/.env. Keep it pointing at localhost, not
# at the tunnel hostname, so a DNS or tunnel problem does not look like a bad
# release.
HEALTH_URL=http://localhost:8101/api/health

# Older releases kept on disk for rollback.
KEEP_RELEASES=5

# Only used when cross-compiling from a workstation. Change GOARCH_TARGET to
# arm64 for a Raspberry Pi or similar.
GOOS_TARGET=linux
GOARCH_TARGET=amd64
