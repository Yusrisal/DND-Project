# Copy to deploy/deploy.env and fill in. That file is gitignored, because it
# names your server. It holds no passwords: the database credentials live in
# /opt/dnd/.env on the server itself and never leave it.

# How to reach the homeserver.
SSH_HOST=192.168.1.15
SSH_USER=yus
SSH_PORT=22

# Where the app lives on the server, and what the unit is called.
REMOTE_DIR=/opt/dnd
SERVICE=dnd-api

# The system account the service runs as. Created by `dnd-deploy setup`.
SERVICE_USER=dnd

# Checked after every restart. A deploy that cannot reach this rolls itself
# back. Keep it pointing at localhost on the server, not at the tunnel
# hostname, so a DNS or tunnel problem does not look like a bad release.
HEALTH_URL=http://localhost:8080/api/health

# Older releases kept on disk for rollback.
KEEP_RELEASES=5

# Set to empty if SSH_USER is root and sudo is not installed.
SUDO=sudo

# Build target. Change GOARCH_TARGET to arm64 for a Raspberry Pi or similar.
GOOS_TARGET=linux
GOARCH_TARGET=amd64
