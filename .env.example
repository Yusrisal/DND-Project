# Server
# APP_ENV=production marks the session cookie Secure, so it is only ever sent
# over HTTPS. Leave it as development when running on plain http://localhost.
APP_ENV=development
HTTP_ADDR=:8080

# MySQL (your own instance; no container involved)
DB_DSN=dnd:dnd@tcp(127.0.0.1:3306)/dnd?parseTime=true&charset=utf8mb4&loc=Local

# Dev only: the Vite origin allowed to call the API and open the websocket.
# In production leave this as the app's own origin, since WEB_DIR puts the
# frontend and the API on one host.
CORS_ORIGINS=http://localhost:5173

# Where uploaded map and token images are written, and served back from under
# /uploads. Relative paths resolve against the working directory.
UPLOAD_DIR=uploads

# Production only: absolute path to the built frontend (frontend/dist).
# Leave empty in dev, where Vite serves the app and proxies /api and /ws.
WEB_DIR=
